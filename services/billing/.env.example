# Billing service configuration — copy to .env and fill in.
# setup-stripe.mjs writes all STRIPE_* values below; every STRIPE_PRICE_* var
# must be set or its plan returns 503 plan_not_configured at checkout.

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_PUBLIC_URL=https://billing.yourdomain.com

# Comma-separated browser origins allowed to call checkout/catalog (the storefront).
BILLING_ALLOWED_ORIGINS=https://www.codestudioplugin.com,https://codestudioplugin.com

# Optional. PORT defaults to 8787; BILLING_STORE_FILE to data/store.json beside
# the server (/data/store.json in the container). STRIPE_API_BASE is for tests
# against a mock — leave unset in production.
#PORT=8787
#BILLING_STORE_FILE=/data/store.json
#STRIPE_API_BASE=

# One Stripe Price id per purchasable plan — 28 in total, one pair per plugin.
# Diagnose by Sound ($50/mo pro, $150/mo team)
STRIPE_PRICE_DBS_PRO=price_...
STRIPE_PRICE_DBS_TEAM=price_...
# Ghost Post Preview ($500/mo pro, $2000/mo team)
STRIPE_PRICE_GPP_PRO=price_...
STRIPE_PRICE_GPP_TEAM=price_...
# Professor Mind-Reader ($50/mo pro, $150/mo team)
STRIPE_PRICE_PMR_PRO=price_...
STRIPE_PRICE_PMR_TEAM=price_...
# 5-Minute Fluency ($10/mo pro, $30/mo team)
STRIPE_PRICE_FMF_PRO=price_...
STRIPE_PRICE_FMF_TEAM=price_...
# Basecamp Split ($5/mo pro, $15/mo team)
STRIPE_PRICE_BCS_PRO=price_...
STRIPE_PRICE_BCS_TEAM=price_...
# Podcast & Video Studio ($100/mo pro, $300/mo team)
STRIPE_PRICE_PVS_PRO=price_...
STRIPE_PRICE_PVS_TEAM=price_...
# Customer Sales Support ($1000/mo pro, $5000/mo team)
STRIPE_PRICE_CSS_PRO=price_...
STRIPE_PRICE_CSS_TEAM=price_...
# Haptic Feedback Mapper ($100/mo pro, $300/mo team)
STRIPE_PRICE_HFM_PRO=price_...
STRIPE_PRICE_HFM_TEAM=price_...
# Mental-Health Chatbot ($20/mo pro, $50/mo team)
STRIPE_PRICE_MHC_PRO=price_...
STRIPE_PRICE_MHC_TEAM=price_...
# Neural-Link Intention Layer ($100/mo pro, $300/mo team)
STRIPE_PRICE_NLI_PRO=price_...
STRIPE_PRICE_NLI_TEAM=price_...
# Generative Digital Twin ($200/mo pro, $500/mo team)
STRIPE_PRICE_GDT_PRO=price_...
STRIPE_PRICE_GDT_TEAM=price_...
# Emotional Resonance Analyzer ($500/mo pro, $1500/mo team)
STRIPE_PRICE_ERA_PRO=price_...
STRIPE_PRICE_ERA_TEAM=price_...
# Code-to-Visual Interpreter ($150/mo pro, $400/mo team)
STRIPE_PRICE_CVI_PRO=price_...
